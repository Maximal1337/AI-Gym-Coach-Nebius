{
  "expo": {
    "name": "Notch Coach",
    "slug": "notch-nebius",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "gymcoach-nebius",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dorbob.gymcoach.nebius",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dorbob.gymcoach.nebius",
      "adaptiveIcon": {
        "backgroundColor": "#0A0B0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-notifications",
      "expo-localization",
      "@sentry/react-native/expo",
      [
        "expo-camera",
        {
          "cameraPermission": "Notch needs camera access to photograph a printed workout plan."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Notch needs photo access to pick a photo of your workout plan."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fd923d4e-10bd-40a2-a6a5-7ea52e51805c"
      }
    },
    "owner": "gymcoach-ai"
  }
}
