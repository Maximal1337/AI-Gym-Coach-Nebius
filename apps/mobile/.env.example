EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
EXPO_PUBLIC_SENTRY_DSN=https://YOUR-KEY@oXXXXXX.ingest.sentry.io/XXXXXXX
EXPO_PUBLIC_POSTHOG_KEY=phc_YOUR-PROJECT-API-KEY
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_YOUR-REVENUECAT-PUBLIC-IOS-KEY
# "true" hides the paywall everywhere — flip together with the SUBSCRIPTION_PAUSED Supabase secret.
EXPO_PUBLIC_SUBSCRIPTION_PAUSED=false
# Dev-only QA sign-in buttons (__DEV__ builds only). Every address must also be in the
# DEV_TEST_LOGIN_EMAILS Supabase secret. Never set this for production builds.
EXPO_PUBLIC_DEV_TEST_ACCOUNTS='[{"email":"qa-active-XXXX@example.com","label":"active trial"},{"email":"qa-expired-XXXX@example.com","label":"subscription ended"},{"email":"qa-new-XXXX@example.com","label":"no data — always onboarding","resetLanguage":true}]'
