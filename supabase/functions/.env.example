# Secrets read by the Edge Functions. Copy to supabase/functions/.env (never
# committed) and push with:
#   supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# by Supabase automatically — don't set them.

# services/agent on Fly.io: base URL (no trailing slash) and the shared secret
# it expects in x-agent-secret (see services/agent/.env.example).
AGENT_URL=https://YOUR-AGENT-APP.fly.dev
AGENT_SHARED_SECRET=YOUR-SHARED-SECRET

# RevenueCat webhook "Authorization header value".
REVENUECAT_WEBHOOK_SECRET=YOUR-REVENUECAT-WEBHOOK-SECRET

# Error reporting (optional — unset disables Sentry).
SENTRY_DSN=https://YOUR-KEY@oXXXXXX.ingest.sentry.io/XXXXXXX
SENTRY_ENVIRONMENT=production

# Monthly per-user LLM cost cap in cents — an abuse circuit breaker, not the paywall (default 50).
USAGE_MONTHLY_BUDGET_CENTS=50

# "true" disables the paywall for everyone; flip together with EXPO_PUBLIC_SUBSCRIPTION_PAUSED in the app.
SUBSCRIPTION_PAUSED=false

# dev-test-login allowlist: comma-separated, lowercase. Every address here signs
# in WITHOUT a one-time code, so use random, non-guessable addresses. App Review
# and demo/judge accounts must be on the app's instant-sign-in domain (@notch.app,
# see apps/mobile/app/sign-in.tsx). Which QA scenario an account resets to is
# configured separately in private.dev_test_accounts.
DEV_TEST_LOGIN_EMAILS=qa-active-XXXX@example.com,ios-review-XXXX@notch.app

# New assistant endpoints (_shared/assistant.ts). Daily caps protect the
# hackathon credits; unset or malformed values fall back to these defaults.
ASSISTANT_DAILY_MESSAGES_PER_USER=100
ASSISTANT_DAILY_MESSAGES_GLOBAL=1000
# Hard Token Factory ceilings per UTC day, in cents (D-34): the agent's prod and
# dev keys, and the nightly memory job. 0 switches a bucket off entirely.
ASSISTANT_SPEND_CEILING_CENTS_PROD=100
ASSISTANT_SPEND_CEILING_CENTS_DEV=50
ASSISTANT_SPEND_CEILING_CENTS_MEMORY=50
# HMAC secrets the relay on the VPS signs its outbox/deliver requests with, one
# per environment (_shared/relay-auth.ts). At least 32 characters, e.g.
# `openssl rand -hex 32`; a shorter value is ignored and that environment
# accepts nothing. The same value goes into that environment's relay secret.
ASSISTANT_RELAY_SECRET_PROD=
ASSISTANT_RELAY_SECRET_DEV=
# Browser origins allowed to call the assistant endpoints (comma-separated).
# The mobile app needs none; leave empty unless a web client is added.
ASSISTANT_ALLOWED_ORIGINS=
