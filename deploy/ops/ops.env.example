# Settings for the ops scripts in deploy/ops, kept on the VPS as
# /etc/notch/ops.env (root, chmod 600); install.sh creates it from this file.
# Plain KEY=value, no quotes, one per line. Never commit a filled copy.

# ---------------------------------------------------------------- health (NH-35)
# The dead man's switch: the ping URL of a healthchecks.io check (free plan)
# with period 5 minutes and grace 10 minutes, e.g. https://hc-ping.com/<uuid>.
# Until it's set, the health timer stays off.
HEALTHCHECK_URL=

# Limits, with their defaults. HEALTH_RELAY_ERRORS_MAX counts the relay's error
# events per environment in the last 10 minutes; the sandbox caps match the
# relay's SANDBOX_MAX_RUNNING.
# HEALTH_DISK_MAX_PCT=85
# HEALTH_MEM_MIN_PCT=10
# HEALTH_LOAD_MAX_PER_CPU=2
# HEALTH_RELAY_ERRORS_MAX=5
# HEALTH_BACKUP_MAX_AGE_HOURS=26
# HEALTH_SANDBOX_CAP_PROD=4
# HEALTH_SANDBOX_CAP_DEV=2

# --------------------------------------------------------------- backups (NH-34)
# Archives kept on the VPS, one per night.
# BACKUP_KEEP=7

# Optional copy off the VPS, to Nebius Object Storage in the VPS's own account
# (a few cents a month). Create a bucket with a lifecycle rule that deletes
# objects after 14 days, and a service account with write access to it; its
# access key goes here. The region is the VPS's (O-02).
# BACKUP_S3_ENDPOINT=https://storage.<region>.nebius.cloud
# BACKUP_S3_REGION=<region>
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
