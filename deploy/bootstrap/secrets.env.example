# One environment's secrets for deploy/bootstrap/secrets.sh. Copy to the VPS
# as /etc/notch/dev.env or /etc/notch/prod.env (root, chmod 600) and fill in.
# Never commit a filled copy. Plain KEY=value, no quotes.

# The environment's relay secret: the same value as the Edge Function secret
# ASSISTANT_RELAY_SECRET_DEV (dev.env) or ASSISTANT_RELAY_SECRET_PROD
# (prod.env). At least 32 characters; generate with: openssl rand -hex 32
RELAY_SECRET=

# https://<project-ref>.supabase.co/functions/v1
SUPABASE_FUNCTIONS_URL=

# The Nemotron model id the sandboxes run (NH-22), used to price each turn's
# spend against the D-34 ceilings.
TOKEN_FACTORY_MODEL=

# Required once RELAY_SANDBOXES=manager (the sandbox manager, NH-55): derives
# each sandbox's Hermes API key, so no key is ever stored. At least 32
# characters: openssl rand -hex 32. Changing it locks the relay out of every
# existing sandbox until they are recreated — keep it with the backups (NH-34).
# SANDBOX_KEY_SECRET=

# While RELAY_SANDBOXES=static (the spike): a JSON map of user id to that
# user's sandbox endpoint, on one line.
# RELAY_STATIC_SANDBOXES={"<user id>":{"baseUrl":"http://...","apiKey":"..."}}
